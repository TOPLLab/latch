else\0aflat out highp uint interpolatedVsInstanceObjectId;\0a#endif\0a#endif\0a\0a#ifdef VERTEX_ID\0a#ifdef NO_GEOMETRY_SHADER\0aout highp float interpolatedMappedVertexId;\0a#else\0aout highp float interpolatedVsMappedVertexId;\0a#endif\0a#endif\0a\0a#ifdef PRIMITIVE_ID_FROM_VERTEX_ID\0a#ifdef NO_GEOMETRY_SHADER\0aflat out highp uint interpolatedPrimitiveId;\0a#else\0aflat out highp uint interpolatedVsPrimitiveId;\0a#endif\0a#endif\0a\0a#ifdef TANGENT_DIRECTION\0aout highp vec4 tangentEndpoint;\0a#endif\0a#if defined(BITANGENT_DIRECTION) || defined(BITANGENT_FROM_TANGENT_DIRECTION)\0aout highp vec4 bitangentEndpoint;\0a#endif\0a#ifdef NORMAL_DIRECTION\0aout highp vec4 normalEndpoint;\0a#endif\0a\0avoid main() {\0a    #ifdef TWO_DIMENSIONS\0a    gl_Position.xywz = vec4(transformationProjectionMatrix*vec3(position, 1.0), 0.0);\0a    #elif defined(THREE_DIMENSIONS)\0a    gl_Position = projectionMatrix*transformationMatrix*position;\0a    #else\0a    #error\0a    #endif\0a\0a    #ifdef TANGENT_DIRECTION\0a    tangentEndpoint = projectionMatrix*(transformationMatrix*position + vec4(normalize(normalMatrix*tangent.xyz)*lineLength, 0.0));\0a    #endif\0a    #ifdef BITANGENT_FROM_TANGENT_DIRECTION\0a    vec3 bitangent = cross(normal, tangent.xyz)*tangent.w;\0a    #endif\0a    #if defined(BITANGENT_DIRECTION) || defined(BITANGENT_FROM_TANGENT_DIRECTION)\0a    bitangentEndpoint = projectionMatrix*(transformationMatrix*position + vec4(normalize(normalMatrix*bitangent)*lineLength, 0.0));\0a    #endif\0a    #ifdef NORMAL_DIRECTION\0a    normalEndpoint = projectionMatrix*(transformationMatrix*position + vec4(normalize(normalMatrix*normal)*lineLength, 0.0));\0a    #endif\0a\0a    #if defined(WIREFRAME_RENDERING) && defined(NO_GEOMETRY_SHADER)\0a    barycentric = vec3(0.0);\0a\0a    #ifdef SUBSCRIPTING_WORKAROUND\0a    #ifndef NEW_GLSL\0a    int i = int(mod(vertexIndex, 3.0));\0a    #else\0a    int i = gl_VertexID % 3;\0a    #endif\0a         if(i == 0) barycentric.x = 1.0;\0a    e