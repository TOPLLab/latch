CLAIM, DAMAGES OR OTHER\0a    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\0a    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\0a    DEALINGS IN THE SOFTWARE.\0a*/\0a\0a#if defined(OBJECT_ID) && !defined(GL_ES) && !defined(NEW_GLSL)\0a#extension GL_EXT_gpu_shader4: require\0a#endif\0a\0a#ifndef NEW_GLSL\0a#define in varying\0a#define fragmentColor gl_FragColor\0a#define texture texture2D\0a#endif\0a\0a#ifndef RUNTIME_CONST\0a#define const\0a#endif\0a\0a#ifdef AMBIENT_TEXTURE\0a#ifdef EXPLICIT_TEXTURE_LAYER\0alayout(binding = 0)\0a#endif\0auniform lowp sampler2D ambientTexture;\0a#endif\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 4)\0a#endif\0auniform lowp vec4 ambientColor\0a    #ifndef GL_ES\0a    #ifndef AMBIENT_TEXTURE\0a    = vec4(0.0)\0a    #else\0a    = vec4(1.0)\0a    #endif\0a    #endif\0a    ;\0a\0a#if LIGHT_COUNT\0a#ifdef DIFFUSE_TEXTURE\0a#ifdef EXPLICIT_TEXTURE_LAYER\0alayout(binding = 1)\0a#endif\0auniform lowp sampler2D diffuseTexture;\0a#endif\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 5)\0a#endif\0auniform lowp vec4 diffuseColor\0a    #ifndef GL_ES\0a    = vec4(1.0)\0a    #endif\0a    ;\0a\0a#ifdef SPECULAR_TEXTURE\0a#ifdef EXPLICIT_TEXTURE_LAYER\0alayout(binding = 2)\0a#endif\0auniform lowp sampler2D specularTexture;\0a#endif\0a\0a#ifdef NORMAL_TEXTURE\0a#ifdef EXPLICIT_TEXTURE_LAYER\0alayout(binding = 3)\0a#endif\0auniform lowp sampler2D normalTexture;\0a#endif\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 6)\0a#endif\0auniform lowp vec4 specularColor\0a    #ifndef GL_ES\0a    = vec4(1.0)\0a    #endif\0a    ;\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 7)\0a#endif\0auniform mediump float shininess\0a    #ifndef GL_ES\0a    = 80.0\0a    #endif\0a    ;\0a#endif\0a\0a#ifdef ALPHA_MASK\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 8)\0a#endif\0auniform lowp float alphaMask\0a    #ifndef GL_ES\0a    = 0.5\0a    #endif\0a    ;\0a#endif\0a\0a#ifdef OBJECT_ID\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 9)\0a#endif\0a/* mediump is just 2^10, which might not be enough, this is 2^16 */\0auniform highp uint objectId; /* defaults to zero */\0a#endif\0a\0a#if LIGHT_COUNT\0a/* Needs to be last because it uses locations 10 + LIGHT_COUNT to\0a   10 + 2*LIGHT_COUNT - 1. Location 10 is lightPositions. Also it can't be\0a   specified as 10 + LIGHT_COUNT because that requires ARB_enhanced_layouts. */\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = LIGHT_COLORS_LOCATION) /* I fear this will blow up some drivers */\0a#endif\0auniform lowp vec4 lightColors[LIGHT_COUNT]\0a    #ifndef GL_ES\0a    = vec4[](LIGHT_COLOR_INITIALIZER)\0a    #endif\0a    ;\0a#endif\0a\0a#if LIGHT_COUNT\0ain mediump vec3 transformedNormal;\0a#ifdef NORMAL_TEXTURE\0ain mediump vec3 transformedTangent;\0a#endif\0ain highp vec3 lightDirections[LIGHT_COUNT];\0ain highp vec3 cameraDirection;\0a#endif\0a\0a#if defined(AMBIENT_TEXTURE) || defined(DIFFUSE_TEXTURE) || defined(SPECULAR_TEXTURE) || defined(NORMAL_TEXTURE)\0ain mediump vec2 interpolatedTextureCoordinates;\0a#endif\0a\0a#ifdef VERTEX_COLOR\0ain lowp vec4 interpolatedVertexColor;\0a#endif\0a\0a#ifdef INSTANCED_OBJECT_ID\0aflat in highp uint interpolatedInstanceObjectId;\0a#endif\0a\0a#ifdef NEW_GLSL\0a#ifdef EXPLICIT_ATTRIB_LOCATION\0alayout(location = COLOR_OUTPUT_ATTRIBUTE_LOCATION)\0a#endif\0aout lowp vec4 fragmentColor;\0a#endif\0a#ifdef OBJECT_ID\0a#ifdef EXPLICIT_ATTRIB_LOCATION\0alayout(location = OBJECT_ID_OUTPUT_ATTRIBUTE_LOCATION)\0a#endif\0a/* mediump is just 2^10, which might not be enough, this is 2^16 */\0aout highp uint fragmentObjectId;\0a#endif\0a\0avoid main() {\0a    lowp const vec4 finalAmbientColor =\0a        #ifdef AMBIENT_TEXTURE\0a        texture(ambientTexture, interpolatedTextureCoordinates)*\0a        #endif\0a        #ifdef VERTEX_COLOR\0a        interpolatedVertexColor*\0a        #endif\0a        ambientColor;\0a    #if LIGHT_COUNT\0a    lowp const vec4 finalDiffuseColor =\0a        #ifdef DIFFUSE_TEXTURE\0a        texture(diffuseTexture, interpolatedTextureCoordinates)*\0a        #endif\0a        #ifdef VERTEX_COLOR\0a        interpolatedVertexColor*\0a        #endif\0a        diffuseColor;\0a    lowp const vec4 finalSpecularColor =\0a        #ifdef SPECULAR_TEXTURE\0a        texture(specularTexture, interpolatedTextureCoordinates)*\0a        #endif\0a        specularColor;\0a    #endif\0a\0a    /* Ambient color */\0a    fragmentColor = finalAmbientColor;\0a\0a    #if LIGHT_COUNT\0a    /* Normal */\0a    mediump vec3 normalizedTransformedNormal = normalize(transformedNormal);\0a    #ifdef NORMAL_TEXTURE\0a    mediump vec3 normalizedTransformedTangent = normalize(transformedTangent);\0a    mediump mat3 tbn = mat3(\0a        normalizedTransformedTangent,\0a        normalize(cross(normalizedTransformedNormal,\0a                        normalizedTransformedTangent)),\0a        normalizedTransformedNormal\0a    );\0a    normalizedTransformedNormal = tbn*(texture(normalTexture, interpolatedTextureCoordinates).rgb*2.0 - vec3(1.0));\0a    #endif\0a\0a    /* Add diffuse color for each light */\0a    for(int i = 0; i < LIGHT_COUNT; ++i) {\0a        highp vec3 normalizedLightDirection = normalize(lightDirections[i]);\0a        lowp float intensity = max(0.0, dot(normalizedTransformedNormal, normalizedLightDirection));\0a        fragmentColor += vec4(finalDiffuseColor.rgb*lightColors[i].rgb*intensity, lightColors[i].a*finalDiffuseColor.a/float(LIGHT_COUNT));\0a\0a        /* Add specular color, if needed */\0a        if(intensity > 0.001) {\0a            highp vec3 reflection = reflect(-normalizedLightDirection, normalizedTransformedNormal);\0a            mediump float specularity = clamp(pow(max(0.0, dot(normalize(cameraDirection), reflection)), shininess), 0.0, 1.0);\0a            fragmentColor += vec4(finalSpecularColor.rgb*specularity, finalSpecularColor.a);\0a        }\0a    }\0a    #endif\0a\0a    #ifdef ALPHA_MAS