aout lowp vec4 backgroundColor;\0aout lowp vec4 lineColor;\0a\0avoid emitQuad(vec4 position, vec2 positionScreen, vec4 endpoint, vec2 endpointScreen) {\0a    /* Calculate screen-space locations for the bar vertices and form two\0a       triangles out of them. In case TBN is rendered alone, half bar width is\0a       lineWidth + smoothness to allow for antialiasing, in case it's rendered\0a       together with wireframe, it's just lineWidth, as antialiasing would\0a       cause depth order issues.\0a\0a        3 - e - 1     -S_-w_0__w_S         -w_0__w\0a        |      /|      | |     | |         |     |\0a        |     / |      | |    /| |         |    /|\0a        |    /  |      | |   / | |         |   / |\0a        |   /   |      | |  /  | |         |  /  |\0a        |  /    |      | | /   | |         | /   |\0a        | /     |      | |/    | |         |/    |\0a        |/      |      |_|_____|_|         |_____|\0a        2 - p - 0     -S -w 0  w S         -w 0  w\0a\0a       The edgeDistance is set to a signed half-width for the antialiased case\0a       and to 0 otherwise. See the fragment shader for details.\0a    */\0a    vec2 direction = normalize(endpointScreen - positionScreen);\0a    #if defined(WIREFRAME_RENDERING) || defined(INSTANCED_OBJECT_ID) || defined(PRIMITIVE_ID) || defined(PRIMITIVE_ID_FROM_VERTEX_ID)\0a    float edgeDistance = 0.0;\0a    vec2 halfSide = lineWidth*vec2(-direction.y, direction.x);\0a    #else\0a    float edgeDistance = lineWidth + smoothness;\0a    vec2 halfSide = edgeDistance*vec2(-direction.y, direction.x);\0a    #endif\0a\0a    /* 0 */\0a    dist = vec3(-edgeDistance);\0a    gl_Position = vec4((positionScreen - halfSide)*position.w/viewportSize, position.zw);\0a    EmitVertex();\0a\0a    /* 1 */\0a    dist = vec3(-edgeDistance);\0a    gl_Position = vec4((endpointScreen - halfSide)*endpoint.w/viewportSize, endpoint.zw);\0a    EmitVertex();\0a\0a    /* 2 */\0a    dist = vec3(edgeDistance);\0a    gl_Position = vec4((positionScreen + halfSide)*position.w/viewportSize, position.zw);\0a    EmitVertex();\0a\0a    /* 3 */\0a    dist = vec3(edgeDistance);\0a    gl_Position = vec4((endpointScreen + halfSide)*endpoint.w/viewportSize, endpoint.zw);\0a    EmitVertex();\0a\0a    EndPrimitive();\0a}\0a#endif\0a\0avoid main() {\0a    /* Passthrough for unchanged variables */\0a    #ifdef INSTANCED_OBJECT_ID\0a    interpolatedInstanceObjectId = interpolatedVsInstanceObjectId[0];\0a    #endif\0a    #ifdef PRIMITIVE_ID_FROM_VERTEX_ID\0a    interpolatedPrimitiveId = interpolatedVsPrimitiveId[0];\0a    #elif defined(PRIMITIVE_ID)\0a    /* This has to be done explicitly, otherwise the fragment input is\0a       undefined. Interestingly enough this worked well on Mesa / Intel with\0a       the GS emitting always just 3 vertices, but not anymore when it emits\0a       also the TBN direction. */\0a    gl_PrimitiveID = gl_PrimitiveIDIn;\0a    #endif\0a\0a    /* Screen position of each vertex + TBN direction */\0a    vec2 p[3];\0a    #ifdef TANGENT_DIRECTION\0a    vec2 t[3];\0a    #endif\0a    #ifdef BITANGENT_DIRECTION\0a    vec2 b[3];\0a    #endif\0a    #ifdef NORMAL_DIRECTION\0a    vec2 n[3];\0a    #endif\0a    for(int i = 0; i != 3; ++i) {\0a        p[i] = viewportSize*gl_in[i].gl_Position.xy/gl_in[i].gl_Position.w;\0a        #ifdef TANGENT_DIRECTION\0a        t[i] = viewportSize*tangentEndpoint[i].xy/tangentEndpoint[i].w;\0a        #endif\0a        #ifdef BITANGENT_DIRECTION\0a        b[i] = viewportSize*bitangentEndpoint[i].xy/bitangentEndpoint[i].w;\0a        #endif\0a        #ifdef NORMAL_DIRECTION\0a        n[i] = viewportSize*normalEndpoint[i].xy/normalEndpoint[i].w;\0a        #endif\0a    }\0a\0a    #if defined(WIREFRAME_RENDERING) || defined(INSTANCED_OBJECT_ID) || defined(PRIMITIVE_ID) || defined(PRIMITIVE_ID_FROM_VERTEX_ID)\0a    /* Vector of each triangle side */\0a    const vec2 v[3] = vec2[3](\0a        p[2]-p[1],\0a        p[2]-p[0],\0a        p[1]-p[0]\0a    );\0a\0a    /* Compute area using perp-dot product */\0a    const float area = abs(dot(vec2(-v[1].y, v[1].x), v[2]));\0a\0a    /* If wireframe is enabled, add distance to opposite side to each vertex.\0a       Otherwise make all distances the same to avoid any lines being drawn.\0a       Propagate also mapped vertex ID, since that changes per-vertex also. */\0a    for(int i = 0; i != 3; ++i) {\0a        dist = vec3(0.0, 0.0, 0.0);\0a        #ifdef WIREFRAME_RENDERING\0a        dist[i] = area/length(v[i]);\0a        #else\0a        dist = vec3(area/length(v[i]));\0a        #endif\0a        #ifdef VERTEX_ID\0a        interpolatedMappedVertexId = interpolatedVsMappedVertexId[i];\0a        #endif\0a        #if defined(TANGENT_DIRECTION) || defined(BITANGENT_DIRECTION) || defined(NORMAL_DIRECTION)\0a        backgroundColor = color;\0a        lineColor = wireframeColor;\0a        #endif\0a        gl_Position = gl_in[i].gl_Position;\0a        EmitVertex();\0a    }\0a\0a    EndPrimitive();\0a    #endif\0a\0a    #if defined(TANGENT_DIRECTION) || defined(BITANGENT_DIRECTION) || defined(NORMAL_DIRECTION)\0a    backgroundColor = vec4(0.0, 0.0, 0.0, 0.0);\0a    for(int i = 0; i != 3; ++i) {\0a        #ifdef TANGENT_DIRECTION\0a        lineColor = vec4(1.0, 0.0, 0.0, 1.0);\0a        emitQuad(gl_in[i].gl_Position, p[i], tangentEndpoint[i], t[i]);\0a        #endif\0a\0a        #ifdef BITANGENT_DIRECTION\0a        lineColor = vec4(0.0, 1.0, 0.0, 1.0);\0a        emitQuad(gl_in[i].gl_Position, p[i], bitangentEndpoint[i], b[i]);\0a        #endif\0a\0a        #ifdef NORMAL_DIRECTION\0a        lineColor = vec4(0.0, 0.0, 1.0, 1.0);\0a        emitQuad(gl_in[i].gl_Position, p[i], normalEndpoint[i], n[i]);\0a        #endif\0a    }\0a    #endif\0a}\0a/*\0a    This file is part of Magnum.\0a\0a    Copyright \c2\a9 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019,\0a                2020 Vladim\c3\adr Vondru\c5\a1 <mosra@centrum.cz>\0a\0a    Permission is hereby granted, free of charge, to any person obtaining a\0a    cop