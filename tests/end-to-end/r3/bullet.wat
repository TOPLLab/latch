e.\0a\0a    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\0a    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\0a    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL\0a    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\0a    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\0a    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\0a    DEALINGS IN THE SOFTWARE.\0a*/\0a\0a#ifndef NEW_GLSL\0a#define in varying\0a#define fragmentColor gl_FragColor\0a#define texture texture2D\0a#endif\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 2)\0a#endif\0auniform lowp vec4 color\0a    #ifndef GL_ES\0a    = vec4(1.0, 1.0, 1.0, 1.0)\0a    #endif\0a    ;\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 3)\0a#endif\0auniform lowp vec4 outlineColor; /* defaults to zero */\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 4)\0a#endif\0auniform lowp vec2 outlineRange\0a    #ifndef GL_ES\0a    = vec2(0.5, 1.0)\0a    #endif\0a    ;\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 5)\0a#endif\0auniform lowp float smoothness\0a    #ifndef GL_ES\0a    = 0.04\0a    #endif\0a    ;\0a\0a#ifdef EXPLICIT_TEXTURE_LAYER\0a/* See AbstractVector.h for details about the ID */\0alayout(binding = 6)\0a#endif\0auniform lowp sampler2D vectorTexture;\0a\0ain mediump vec2 interpolatedTextureCoordinates;\0a\0a#ifdef NEW_GLSL\0a#ifdef EXPLICIT_ATTRIB_LOCATION\0alayout(location = COLOR_OUTPUT_ATTRIBUTE_LOCATION)\0a#endif\0aout lowp vec4 fragmentColor;\0a#endif\0a\0avoid main() {\0a    lowp float intensity = texture(vectorTexture, interpolatedTextureCoordinates).r;\0a\0a    /* Fill color */\0a    fragmentColor = smoothstep(outlineRange.x-smoothness, outlineRange.x+smoothness, intensity)*color;\0a\0a    /* Outline */\0a    if(outlineRange.x > outlineRange.y) {\0a        /* Doing *0.5 instead of /2.0 because the latter causes iOS / WebGL to\0a           complain that \22Overflow in implicit constant conversion, minimum\0a           range for lowp float is (-2,2)\22 */\0a        lowp float mid = (outlineRange.x + outlineRange.y)*0.5;\0a        lowp float halfRange = (outlineRange.x - outlineRange.y)*0.5;\0a        fragmentColor += smoothstep(halfRange+smoothness, halfRange-smoothness, distance(mid, intensity))*outlineColor;\0a    }\0a}\0a/*\0a    This file is part of Magnum.\0a\0a    Copyright \c2\a9 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019,\0a                2020 Vladim\c3\adr Vondru\c5\a1 <mosra@centrum.cz>\0a\0a    Permission is hereby granted, free of charge, to any person obtaining a\0a    copy of this software and associated documentation files (the \22Software\22),\0a    to deal in the Software without restriction, including without limitation\0a    the rights to use, copy, modify, merge, publish, distribute, sublicense,\0a    and/or sell copies of the Software, and to permit persons to whom the\0a    Software is furnished to do so, subject to the following conditions:\0a\0a    The above copyright notice and this permission notice shall be included\0a    in all copies or substantial portions of the Software.\0a\0a    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\0a    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\0a    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL\0a    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\0a    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\0a    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\0a    DEALINGS IN THE SOFTWARE.\0a*/\0a\0a#if defined(OBJECT_ID) && !defined(GL_ES) && !defined(NEW_GLSL)\0a#extension GL_EXT_gpu_shader4: require\0a#endif\0a\0a#ifndef NEW_GLSL\0a#define fragmentColor gl_FragColor\0a#define texture texture2D\0a#define in varying\0a#endif\0a\0a#ifdef TEXTURED\0a#