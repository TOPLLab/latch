\0a#endif\0a\0a#if defined(WIREFRAME_RENDERING) && defined(GL_ES) && __VERSION__ < 300\0a#extension GL_OES_standard_derivatives : enable\0a#endif\0a\0a#if defined(GL_ES) && !defined(NO_GEOMETRY_SHADER) && defined(GL_NV_shader_noperspective_interpolation)\0a#extension GL_NV_shader_noperspective_interpolation: require\0a#endif\0a\0a#if (defined(WIREFRAME_RENDERING) || defined(INSTANCED_OBJECT_ID) || defined(VERTEX_ID) || defined(PRIMITIVE_ID) || defined(PRIMITIVE_ID_FROM_VERTEX_ID)) && !defined(TBN_DIRECTION)\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 1)\0a#endif\0auniform lowp vec4 color\0a    #ifndef GL_ES\0a    = vec4(1.0, 1.0, 1.0, 1.0)\0a    #endif\0a    ;\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 2)\0a#endif\0auniform lowp vec4 wireframeColor\0a    #ifndef GL_ES\0a    = vec4(0.0, 0.0, 0.0, 1.0)\0a    #endif\0a    ;\0a#endif\0a\0a#ifdef WIREFRAME_RENDERING\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 3)\0a#endif\0auniform lowp float wireframeWidth\0a    #ifndef GL_ES\0a    = 1.0\0a    #endif\0a    ;\0a#elif defined(TBN_DIRECTION)\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 9)\0a#endif\0auniform lowp float lineWidth\0a    #ifndef GL_ES\0a    = 1.0\0a    #endif\0a    ;\0a#endif\0a\0a#if defined(WIREFRAME_RENDERING) || defined(TBN_DIRECTION)\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 4)\0a#endif\0auniform lowp float smoothness\0a    #ifndef GL_ES\0a    = 2.0\0a    #endif\0a    ;\0a#endif\0a\0a#if defined(INSTANCED_OBJECT_ID) || defined(VERTEX_ID) || defined(PRIMITIVE_ID) || defined(PRIMITIVE_ID_FROM_VERTEX_ID)\0a#ifdef EXPLICIT_TEXTURE_LAYER\0alayout(binding = 4)\0a#endif\0auniform lowp sampler2D colorMapTexture;\0a#endif\0a\0a#if defined(INSTANCED_OBJECT_ID) || defined(PRIMITIVE_ID) || defined(PRIMITIVE_ID_FROM_VERTEX_ID)\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 6)\0a#endif\0auniform lowp vec2 colorMapOffsetScale\0a    #ifndef GL_ES\0a    = vec2(1.0/512.0, 1.0/256.0)\0a    #endif\0a    ;\0a#define colorMapOffset colorMapOffsetScale.x\0a#define colorMapScale colorMapOffsetScale.y\0a#endif\0a\0a#if defined(WIREFRAME_RENDERING) || defined(TBN_DIRECTION)\0a#ifndef NO_GEOMETRY_SHADER\0a#if !defined(GL_ES) || defined(GL_NV_shader_noperspective_interpolation)\0anoperspective\0a#endif\0ain lowp vec3 dist;\0a#else\0ain lowp vec3 barycentric;\0a#endif\0a#endif\0a\0a#ifdef INSTANCED_OBJECT_ID\0aflat in highp uint interpolatedInstanceObjectId;\0a#endif\0a#ifdef VERTEX_ID\0ain highp float interpolatedMappedVertexId;\0a#endif\0a#ifdef PRIMITIVE_ID_FROM_VERTEX_ID\0aflat in highp uint interpolatedPrimitiveId;\0a#endif\0a\0a#ifdef TBN_DIRECTION\0ain lowp vec4 backgroundColor;\0ain lowp vec4 lineColor;\0a#endif\0a\0a#ifdef NEW_GLSL\0a#ifdef EXPLICIT_ATTRIB_LOCATION\0alayout(location = COLOR_OUTPUT_ATTRIBUTE_LOCATION)\0a#endif\0aout lowp vec4 fragmentColor;\0a#endif\0a\0avoid main() {\0a    /* Map object/vertex/primitive ID to a color. Will be either combined with\0a       the wireframe background color (if wireframe is enabled), ignored (if\0a       rendering TBN direction) or used as-is if nothing else is enabled */\0a    #if defined(INSTANCED_OBJECT_ID) || defined(VERTEX_ID) || defined(PRIMITIVE_ID) || defined(PRIMITIVE_ID_FROM_VERTEX_ID)\0a    lowp vec4 faceColor = texture(colorMapTexture, vec2(\0a        /* Object/primitive IDs are constant across the whole primitive so we\0a           do the offset/scale mapping here */\0a        #if defined(INSTANCED_OBJECT_ID) || defined(PRIMITIVE_ID) || defined(PRIMITIVE_ID_FROM_VERTEX_ID)\0a        colorMapOffset + float(\0a            #ifdef INSTANCED_OBJECT_ID\0a            interpolatedInstanceObjectId\0a            #elif defined(PRIMITIVE_ID)\0a            gl_PrimitiveID\0a            #elif defined(PRIMITIVE_ID_FROM_VERTEX_ID)\0a            interpolatedPrimitiveId\0a            #else\0a            #error mosra messed up\0a            #endif\0a        )*colorMapScale\0a\0a        /* Vertex ID changes, so the offset/scale mapping was done already in\0a           a VS/GS and we just pass the interpolated result to a texture */\0a        #elif defined(VERTEX_ID)\0a        interpolatedMappedVertexId\0a        #else\0a        #error mosra messed up, again\0a        #endif\0a        , 0.0));\0a    #endif\0a\0a    /* 1. For wireframe the line is on the triangle edges, thus dist = 0 at\0a          vertices and dist = w (= wireframeWidth) at center of smoothed edge.\0a       2. For antialiased TBN (drawn alone) the line is in the center of the\0a          bar, thus dist = 0 at the center, dist = \c2\b1w (= lineWidth) at center\0a          of the smoothed edge, and dist = \c2\b1S = w + s (= smoothness) at edge of\0a          the primitive.\0a       3. For non-antialised TBN (drawn together with wireframe) the bar width\0a          is without the extra padding for smoothness.\0a\0a        0 _____________ 0          -S_-w_0__w_S         -w_0__w\0a          \5c  _______  /             | |     | |         |     |\0a           \5c w     w /              | |    /| |         |    /|\0a            \5c \5c   / /               | |   / | |         |   / |\0a             \5c \5cw/ /                | |  /  | |         |  /  |\0a              \5c v /                 | | /   | |         | /   |\0a               \5c /                  | |/    | |         |/    |\0a                v                   |_|_____|_|         |_____|\0a                0                  -S -w 0  w S         -w 0  w\0a    */\0a    #if defined(WIREFRAME_RENDERING) || defined(TBN_DIRECTION)\0a\0a    /* Fill with background color first:\0a\0a       1. For wireframe alone the color is supplied directly from the color\0a          uniform\0a       2. For TBN alone the backgroundColor is supplied from the GS\0a\0a       If primitive/object ID is enabled, it multiplies the color.\0a    */\0a    #if defined(WIREFRAME_RENDERING) && !defined(TBN_DIRECTION)\0a    fragmentColor = color;\0a    #else\0a    fragmentColor = backgroundColor;\0a    #endif\0a    #if defined(INSTANCED_OBJECT_ID) || defined(VERTEX_ID) || defined(PRIMITIVE_ID) || defined(PRIMITIVE_ID_FROM_VERTEX_ID)\0a    fragmentColor *= faceColor;\0a    #endif\0a\0a    #ifndef NO_GEOMETRY_SHADER\0a    /* Distance to nearest side. If signed distance is involved when rendering\0a       TBN alone, we need to find an absolute distance */\0a    #if defined(TBN_DIRECTION) && !defined(WIREFRAME_RENDERING)\0a    lowp const float nearest = min(min(abs(dist.x), abs(dist.y)), abs(dist.z));\0a    #else\0a    lowp const float nearest = min(min(dist.x, dist.y), dist.z);\0a    #endif\0a\0a    /* Mix in the line color:\0a\0a       1. For wireframe alone the width and colors are supplied directly from\0a          wireframeWidth, wireframeColor, color uniforms\0a       2. For TBN alone the width is supplied directly from the lineWidth\0a          uniform and colors from the GS\0a       3. For TBN and wireframe together wireframeWidth is used to draw the\0a          wireframe, and since `nearest` is always 0 for the TBN bars, there it\0a          doesn't matter.\0a    */\0a    fragmentColor = mix(\0a        #if defined(WIREFRAME_RENDERING) && !defined(TBN_DIRECTION)\0a        wireframeColor,\0a        #else\0a        lineColor,\0a        #endif\0a        fragmentColor,\0a        #ifdef WIREFRAME_RENDERING\0a        smoothstep(wireframeWidth - smoothness,\0a                   wireframeWidth + smoothness, nearest)\0a        #elif defined(TBN_DIRECTION)\0a        smoothstep(lineWidth - smoothness,\0a                   lineWidth + smoothness, nearest)\0a        #else\0a        #error\0a        #endif\0a        );\0a\0a    /* Wireframe rendering without a GS. No TBN in this case */\0a    #else\0a    const lowp vec3 d = fwidth(barycentric);\0a    const lowp vec3 factor = smoothstep(vec3(0.0), d*1.5, barycentric);\0a    const lowp float nearest = min(min(factor.x, factor.y), factor.z);\0a    fragmentColor = mix(wireframeColor, fragmentColor, nearest);\0a    #endif\0a\0a    /* Object / Vertex / Primitive ID visualization using a colormap */\0a    #elif defined(INSTANCED_OBJECT_ID) || defined(VERTEX_ID) || defined(PRIMITIVE_ID) || defined(PRIMITIVE_ID_FROM_VERTEX_ID)\0a    fragmentColor = color*faceColor;\0a\0a    #else\0a    #error no visualization enabled, huh?\0a    #endif\0a}\0a/*\0a    This file is part of Magnum.\0a\0a    Copyright \c2\a9 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019,\0a                2020 Vladim\c3\adr Vondru\c5\a1 <mosra@centrum.cz>\0a\0a    Permission is hereby granted, free of charge, to any person obtaining a\0a    copy of this software and associated documentation files (the \22Software\22),\0a    to deal in the Software without restriction, including without limitation\0a    the rights to use, copy, modify, merge, publish, distribute, sublicense,\0a    and/or sell copies of the Software, and to permit persons to whom the\0a    Software is furnished to do so, subject to the following conditions:\0a\0a    The above copyright notice and this permission notice shall be included\0a    in all copies or substantial portions of the Software.\0a\0a    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\0a    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\0a    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL\0a    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\0a    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\0a    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\0a    DEALINGS IN THE SOFTWARE.\0a*/\0a\0a#ifndef RUNTIME_CONST\0a#define const\0a#endif\0a\0a#ifdef GL_ES\0a#extension GL_EXT_geometry_shader: require\0a#ifdef GL_NV_shader_noperspective_interpolation\0a#extension GL_NV_shader_noperspective_interpolation: require\0a#endif\0a#endif\0a\0a#ifdef EXPLICIT_UNIFORM_LOCATION\0alayout(location = 5)\0a#endif\0auniform lowp vec2 viewportSize; /* defaults to